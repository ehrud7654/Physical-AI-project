<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so101_orchestrator</name>
  <version>0.0.1</version>
  <description>
    배포 오케스트레이터 — BE(제어 평면) 명령을 SSE로 받아 정책 노드를 lifecycle 제어하고,
    상태를 HTTP POST로 BE에 보낸다. 젯슨은 클라이언트(httpx), FastAPI 아님. (S15P21A103-115)
  </description>
  <maintainer email="shwzone@gmail.com">Hw</maintainer>
  <license>TODO</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <exec_depend>python3-httpx</exec_depend>

  <!-- httpx·pytest 는 apt 패키지: rosdep install 로 자동, 또는 apt install python3-httpx python3-pytest -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
