<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so101_driver</name>
  <version>0.0.1</version>
  <description>
    SO-101 하드웨어 드라이버. /joint_command(라디안) 구독→모터 write,
    /joint_states(라디안) 30Hz 발행, /estop 구독→토크 off.
    ROS 경계(래퍼)만 여기 정의하고, Feetech 시리얼 구현은 HardwareInterface 구현체가 채운다. (S15P21A103-50)
  </description>
  <maintainer email="shwzone@gmail.com">Hw</maintainer>
  <license>TODO</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <!-- Feetech SDK(예: feetech-servo-sdk)는 HardwareInterface 구현체(팀원)가 pip로 -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
