<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <android.opengl.GLSurfaceView
        android:id="@+id/glView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 상단 상태바: 추적 신호등 + AE 배지 + 드롭경고 + REC 타이머 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/chrome"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/sigDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/silverMuted"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/sigText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="준비 중…"
            android:textColor="@color/silver"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dropWarn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:text="⚠ 누락"
            android:textColor="@color/stRed"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/aeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:text="밝기 자동 (고정 필요)"
            android:textColor="@color/stAmber"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/recTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● 00:00"
            android:textColor="@color/stRed"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 활성 학습 배지 (탭 → 학습 선택). 항상 보여 오배정 예방 -->
    <TextView
        android:id="@+id/learnBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="52dp"
        android:layout_marginStart="16dp"
        android:background="@color/chrome"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="학습: 미선택 ▾"
        android:textColor="@color/stIndigo"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- 상세(개발용 원시값). 기본 숨김, ⓘ 토글로 표시 -->
    <TextView
        android:id="@+id/poseText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="100dp"
        android:background="#AA000000"
        android:padding="10dp"
        android:textColor="#00FF66"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:visibility="gone"
        android:text="@string/waiting" />

    <!-- 우상단: 상세토글 · 기록 · 설정 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="horizontal"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="12dp">

        <Button
            android:id="@+id/detailBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:background="@color/chrome"
            android:textColor="@color/silverMuted"
            android:textSize="13sp"
            android:text="ⓘ" />

        <Button
            android:id="@+id/historyBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@color/chrome"
            android:textColor="@color/silver"
            android:textSize="13sp"
            android:text="기록" />

        <Button
            android:id="@+id/settingsBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@color/chrome"
            android:textColor="@color/silver"
            android:textSize="13sp"
            android:text="설정" />
    </LinearLayout>

    <!-- 하단 중앙: 큰 REC -->
    <Button
        android:id="@+id/recBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:paddingHorizontal="64dp"
        android:paddingVertical="14dp"
        android:background="@color/navy700"
        android:textColor="@color/silver"
        android:textSize="22sp"
        android:text="촬영 시작" />
</FrameLayout>
