<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pageLight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 상단바 (기록 화면과 위치/크기 통일: 컨테이너 16dp + backBtn -10dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="-10dp"
                android:src="@drawable/ic_back"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:contentDescription="뒤로" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="설정"
                android:textColor="@color/inkPrimary"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- 촬영 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="촬영"
            android:textColor="@color/inkMuted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_light"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="초점 고정"
                        android:textColor="@color/inkPrimary"
                        android:textSize="16sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="배경 특징점이 선명해 추적에 유리 · 권장"
                        android:textColor="@color/inkMuted"
                        android:textSize="13sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/afSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:track="@drawable/switch_track"
                    android:thumb="@drawable/switch_thumb"
                    android:switchMinWidth="52dp"
                    android:thumbTextPadding="0dp"
                    android:showText="false"
                    android:textOn=""
                    android:textOff="" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="18dp"
                android:background="@color/hairline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="밝기·색 고정"
                        android:textColor="@color/inkPrimary"
                        android:textSize="16sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="밝기·화이트밸런스 고정 · 데이터 일관성 · 권장"
                        android:textColor="@color/inkMuted"
                        android:textSize="13sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/aeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:track="@drawable/switch_track"
                    android:thumb="@drawable/switch_thumb"
                    android:switchMinWidth="52dp"
                    android:thumbTextPadding="0dp"
                    android:showText="false"
                    android:textOn=""
                    android:textOff="" />
            </LinearLayout>
        </LinearLayout>

        <!-- 화질 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="화질"
            android:textColor="@color/inkMuted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_light"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="해상도"
                        android:textColor="@color/inkPrimary"
                        android:textSize="16sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="데이터 계약 · 변경 불가"
                        android:textColor="@color/inkMuted"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1920×1080 (16:9)"
                    android:textColor="@color/inkSecondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 촬영 보조 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="촬영 보조"
            android:textColor="@color/inkMuted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_light"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="구도 그리드"
                        android:textColor="@color/inkPrimary"
                        android:textSize="16sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="화면에 3분할 안내선"
                        android:textColor="@color/inkMuted"
                        android:textSize="13sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/gridSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:track="@drawable/switch_track"
                    android:thumb="@drawable/switch_thumb"
                    android:switchMinWidth="52dp"
                    android:thumbTextPadding="0dp"
                    android:showText="false"
                    android:textOn=""
                    android:textOff="" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="18dp"
                android:background="@color/hairline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="상세값 표시"
                        android:textColor="@color/inkPrimary"
                        android:textSize="16sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="pose·마커 원시값 (개발용)"
                        android:textColor="@color/inkMuted"
                        android:textSize="13sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/detailSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:track="@drawable/switch_track"
                    android:thumb="@drawable/switch_thumb"
                    android:switchMinWidth="52dp"
                    android:thumbTextPadding="0dp"
                    android:showText="false"
                    android:textOn=""
                    android:textOff="" />
            </LinearLayout>
        </LinearLayout>
        <!-- 디버그 (테스트 전용, 디버그 빌드에서만 보임) -->
        <LinearLayout
            android:id="@+id/debugSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:text="디버그 (테스트 전용)"
                android:textColor="@color/inkMuted" android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:orientation="vertical"
                android:background="@drawable/bg_card_light" android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="디버그 업로드 사용"
                        android:textColor="@color/inkPrimary" android:textSize="16sp" />
                    <Switch android:id="@+id/debugSwitch"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:track="@drawable/switch_track" android:thumb="@drawable/switch_thumb"
                        android:switchMinWidth="52dp" android:thumbTextPadding="0dp"
                        android:showText="false" android:textOn="" android:textOff="" />
                </LinearLayout>

                <EditText android:id="@+id/jobIdInput"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:hint="trainingJobId"
                    android:textColor="@color/inkPrimary" android:textColorHint="@color/inkMuted"
                    android:textSize="14sp" android:background="@drawable/bg_pick_row_light"
                    android:padding="12dp" android:inputType="text" android:maxLines="1" />

                <EditText android:id="@+id/deviceIdInput"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:hint="deviceId"
                    android:textColor="@color/inkPrimary" android:textColorHint="@color/inkMuted"
                    android:textSize="14sp" android:background="@drawable/bg_pick_row_light"
                    android:padding="12dp" android:inputType="text" android:maxLines="1" />

                <EditText android:id="@+id/secretInput"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:hint="deviceSecret"
                    android:textColor="@color/inkPrimary" android:textColorHint="@color/inkMuted"
                    android:textSize="14sp" android:background="@drawable/bg_pick_row_light"
                    android:padding="12dp" android:inputType="text" android:maxLines="1" />

                <TextView android:id="@+id/focusLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="초점 거리"
                    android:textColor="@color/inkPrimary" android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="FIXED(초점 고정)일 때만 적용 · 슬라이드해 파지/작업거리 맞춤"
                    android:textColor="@color/inkMuted" android:textSize="12sp" />
                <SeekBar android:id="@+id/focusSeek"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:max="120"
                    android:progressTint="@color/azure" android:thumbTint="@color/azure" />

                <Button android:id="@+id/saveDebugBtn"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:layout_gravity="end"
                    android:text="저장" android:textColor="@color/azureInk"
                    android:background="@drawable/bg_btn_azure"
                    android:paddingHorizontal="20dp" android:paddingVertical="10dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
