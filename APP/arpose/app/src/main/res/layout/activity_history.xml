<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pageLight">

    <!-- 상단바: 뒤로 · 제목(기록/N개 선택) · 전체 선택 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/backBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="-10dp"
            android:src="@drawable/ic_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="뒤로" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="기록"
            android:textColor="@color/inkPrimary"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/selectAllBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="전체 선택"
            android:textColor="@color/azureInk"
            android:textSize="14sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:text="촬영 기록이 없습니다"
        android:textColor="@color/inkMuted"
        android:textSize="15sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/historyScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/historyList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </ScrollView>

    <!-- 페이지 이동 (번호는 코드로 생성) -->
    <LinearLayout
        android:id="@+id/pagerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="8dp" />

    <!-- 하단 액션바: 선택 시만 등장. [선택 삭제] ———— [전송] -->
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/pageLight"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/deleteSelectedBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="선택 삭제"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="11dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/sendBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="전송"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_azure"
            android:paddingHorizontal="22dp"
            android:paddingVertical="12dp"
            android:drawableStart="@drawable/ic_send"
            android:drawableTint="#FFFFFFFF"
            android:drawablePadding="8dp" />
    </LinearLayout>
</LinearLayout>
