# Database images are configured in compose.yaml: postgres:17-alpine, redis:7-alpine.

# User login sessions (Secure cookies must remain enabled on HTTPS deployments)
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=8h
SESSION_COOKIE_SECURE=true

# POSTGRES_DB=DB_name
# POSTGRES_USER=User_name
# POSTGRES_PASSWORD=로컬개발용_비밀번호

S3_BUCKET_NAME=s3_bucket_name
# AWS_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_PROFILE=personal-s3
# AWS_CONFIG_DIR=/home/ubuntu/.aws
# EPISODE_PRESIGN_TTL=15m
# 학습 데이터 zip파일 최대 용량 (200MB)
EPISODE_MAX_UPLOAD_BYTES=209715200

# HTTPS (Let's Encrypt)
# TLS_DOMAIN의 DNS A 레코드는 이 EC2의 공인 IP를 가리켜야 합니다.
TLS_DOMAIN=서버IP주소
CERTBOT_EMAIL=your-email@example.com
