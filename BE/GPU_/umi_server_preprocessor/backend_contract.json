{
  "schema": "orbslam_atlas_backend_handoff/0.3.0",
  "created_date": "2026-09-23",
  "marker": {
    "dictionary": "DICT_4X4_50",
    "id": 13,
    "black_square_size_m": 0.16,
    "mapping_alignment_required": true,
    "demonstration_visibility_required": false,
    "demonstration_visibility_semantics": "diagnostic_only"
  },
  "roles": {
    "must_be_explicit": true,
    "inference_forbidden": ["outcome", "duration", "filename", "directory_order", "zip_order"],
    "mapping": {
      "count": 1,
      "outcome_required": false,
      "purpose": "Atlas creation and table-frame alignment"
    },
    "demonstration": {
      "minimum_count": 1,
      "training_outcome": "success",
      "purpose": "task episode loaded from the immutable shared Atlas; process-local mapping is allowed"
    },
    "source_one_of": ["mapping_session_id", "external_atlas_path+external_alignment_path"]
  },
  "orbslam": {
    "source_commit": "b741dca39015330ef4bcc3a85f89493503ade04b",
    "verified_binary_sha256": "9ac6980e99221b8255b7b9cf1f6d274bd0fd74e746a6033c4ef8dc822218d6cb",
    "required_flags": [
      "--use_sensor_timestamps",
      "--save_map",
      "--load_map",
      "--mask_img",
      "--init_tag_id",
      "--init_tag_size"
    ],
    "mapping_mode": ["--save_map"],
    "demonstration_mode": ["--load_map"],
    "demonstration_forbidden_flags": ["--localization_only", "--save_map"],
    "preflight_help_flags": ["--use_sensor_timestamps", "--save_map", "--load_map"],
    "shared_atlas_must_remain_byte_identical": true
  },
  "selection_gate": {
    "minimum_coverage": 0.95,
    "maximum_first_pose_time_s": 0.5,
    "maximum_timestamp_error_ms": 2.0,
    "tracking_loss_after_initialization_allowed": false,
    "final_frame_must_be_tracked": true,
    "maximum_gripper_missing_run_frames": 15,
    "pose_continuity_required": true,
    "maximum_consecutive_translation_m": 0.25,
    "maximum_consecutive_rotation_deg": 45.0,
    "continuity_limit_semantics": "provisional catastrophic relocalisation-jump guard; values are recorded in every trajectory report",
    "process_exit_zero_is_quality_pass": false
  },
  "required_outputs": [
    "processed_mapping/<mapping>/slam/map_atlas.osa",
    "processed_mapping/<mapping>/slam/camera_trajectory.csv",
    "processed_mapping/<mapping>/tx_slam_tag.json",
    "processed/<episode>/slam/camera_trajectory.csv",
    "processed/<episode>/slam/trajectory_validation.json",
    "pipeline_report.json",
    "dataset/<name>.zarr.zip",
    "dataset/<name>.zarr.report.json",
    "job_status.json"
  ],
  "publication_gate": {
    "pose_continuity": "PROVISIONAL_CATASTROPHIC_JUMP_GUARD",
    "physical_deployment": false,
    "notes": "state=2/is_lost=false and process exit zero are insufficient; training publication fails closed on configured discontinuous relocalization jumps. This does not approve physical deployment."
  }
}
