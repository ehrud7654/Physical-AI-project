FASTAPI_SERVICE_TOKEN=change-this-in-production
GPU_SPRING_BASE_URL=http://gpu-backend:8081
GPU_SPRING_CALLBACK_TOKEN=change-this-in-production
WORKER_ID=ssafy_gpu_01
STORAGE_NODE_ID=18000000-0000-4000-8000-000000000002
SHARED_STORAGE_ROOT=/data/ssafy-gpu
RUN_JOURNAL_ROOT=/data/ssafy-gpu/journal/training-runs
SUPPORTED_ALGORITHMS=ACT
# Host physical GPU 2 is the only GPU exposed by Compose. It is logical GPU 0
# inside the container, so the application manages exactly one GPU.
GPU_COUNT=1
TRAINING_COMMAND_DURATION_SECONDS=5
SUPERVISOR_INTERVAL_SECONDS=1
COMPLETION_RETRY_SECONDS=5
