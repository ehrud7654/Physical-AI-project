# Remote EC2 API. Do not use the EC2 Compose service name from this laptop.
EC2_API_BASE_URL=서버_URL

# Laptop worker identity and local GPU allocation.
GPU_WORKER_ID=ssafy_gpu_laptop_01
GPU_NODE_KEY=gpu-laptop-local-cache
GPU_NODE_NAME=SSAFY GPU Laptop Worker
GPU_MAX_SLOTS=1
GPU_CLAIM_POLLING_ENABLED=true
GPU_CLAIM_POLLING_INITIAL_DELAY=20s
GPU_CLAIM_POLLING_INTERVAL=5s
GPU_CLAIM_AVAILABLE_MEMORY_MIB=32768
GPU_GIT_REVISION=local
# Docker 호스트에서 사용할 물리 GPU 번호입니다.
# 노트북은 보통 0, 지급 GPU 서버는 할당받은 물리 GPU 번호 2를 사용합니다.
GPU_DEVICE_ID=0

# Internal Spring Boot <-> FastAPI authentication.
FASTAPI_SERVICE_TOKEN=change-this-local-service-token
GPU_SPRING_CALLBACK_TOKEN=change-this-local-callback-token

FASTAPI_CONNECT_TIMEOUT=3s
FASTAPI_READ_TIMEOUT=15s
FASTAPI_MONITOR_INTERVAL=2s

# CKPT는 AWS 자격 증명 없이 EC2가 발급한 Presigned PUT URL로 업로드합니다.
CHECKPOINT_CONTENT_TYPE=application/octet-stream
CHECKPOINT_UPLOAD_TIMEOUT=10m
CHECKPOINT_UPLOAD_MAX_ATTEMPTS=3

# 학습 종료 후 로컬 입력·결과 정리 및 비정상 종료 orphan 복구.
GPU_TRAINING_CLEANUP_ENABLED=true
GPU_ORPHAN_GRACE_PERIOD=24h
GPU_CLEANUP_SCAN_INTERVAL=1h

# UMI Episode preprocessing (GPU Spring -> umi-preprocessor)
UMI_PREPROCESSOR_CONNECT_TIMEOUT=3s
UMI_PREPROCESSOR_READ_TIMEOUT=30s
UMI_PREPROCESSOR_POLL_INTERVAL=2s
UMI_PREPROCESSOR_TIMEOUT=30m
UMI_PREPROCESSOR_CALIBRATION_PROFILE=s22_20260921
UMI_PREPROCESSOR_REQUIRE_MAPPING=false

STORAGE_NODE_ID=DB_storage_node_id
TRAINING_COMMAND_DURATION_SECONDS=5

# Checkpoint manifest metadata
ROBOT_PROFILE_ID=robot_id
MODEL_FRAMEWORK=PyTorch
MODEL_FRAMEWORK_VERSION=integration-pending
MODEL_CONTRACT_VERSION=umi-policy-v1
MODEL_ACTION_SPACE=EEF_RELATIVE_ROT6D
MODEL_ACTION_SPEC_JSON={"schemaVersion":1,"dim":10,"horizon":8,"rateHz":10,"rateNote":"공칭. v10 원본 간격이 균일하지 않다. 실제 시각은 observation_timestamp","layout":["dx","dy","dz","r00","r01","r02","r10","r11","r12","gap_m"],"rotation":"ROTATION_MATRIX_ROWS_0_1","compose":"T_next = T_cur @ A_relative","gapUnit":"m","gapRange":[0,0.09]}
MODEL_RUNTIME_SPEC_JSON={"consumerMustConvert":true,"convertedDim":7,"convertedLayout":["x","y","z","rx","ry","rz","gap_m"],"convertedRotation":"AXIS_ANGLE_ROTVEC","convertedFrame":"ABSOLUTE","execSlice":{"startInclusive":1,"endExclusive":5},"execSliceAppliesTo":"converted","actionPointRateHz":10,"reobserveRateHz":2.5}
TRAINING_EPOCHS=60
MODEL_PARAMETER_COUNT=1
MODEL_CONTROL_RATE_HZ=30
MODEL_CAMERA_NAMES_JSON=["camera0_rgb"]
MODEL_INPUT_SCHEMA_JSON={"stateShape":[10]}
MODEL_OUTPUT_SCHEMA_JSON={"actionShape":[8,10]}

# Optional profiles.
DCGM_EXPORTER_PORT=9400
DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:latest
SIMULATION_WORKER_IMAGE=ssafy-simulation-worker:local
